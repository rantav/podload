{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Podload",
  "version": "0.1.0",
  "identifier": "com.rantavory.podload",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Podload",
        "width": 1200,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost",
        "media-src": "'self' https: http: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "devCsp": {
        "default-src": "'self' 'unsafe-inline' 'unsafe-eval' ws://localhost:* http://localhost:*",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost",
        "media-src": "'self' https: http: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
